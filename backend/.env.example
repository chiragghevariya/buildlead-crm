APP_NAME="BuildLead CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020
FRONTEND_URL=http://localhost:5190

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildlead
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@buildlead.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- BuildLead: AI scoring -------------------------------------------------
# Leave OPENAI_API_KEY empty to score with rules only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
# OPENAI_BASE_URL=https://api.openai.com/v1

SCORING_AI_ENABLED=true
SCORING_AI_WEIGHT=0.6
SCORING_HOT_THRESHOLD=75
SCORING_WARM_THRESHOLD=50
SCORING_AUTO_ASSIGN=true

# Optional Slack incoming webhook for hot lead alerts
SLACK_HOT_LEAD_WEBHOOK_URL=

# --- BuildLead: lead ingest ------------------------------------------------
# Shared secret for POST /api/leads/ingest (website forms, email/phone integrations).
# Generate one with: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
LEAD_INGEST_TOKEN=

# Browser origins allowed to call the ingest webhook ("*" = any website) and per-IP rate limit.
INGEST_ALLOWED_ORIGINS=*
INGEST_RATE_PER_MINUTE=20

# SPA origins allowed by CORS for the authenticated API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5190,http://127.0.0.1:5190
